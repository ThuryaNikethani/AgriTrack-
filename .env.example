# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agritrack?schema=public"

# Auth.js secret - generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: e-mail notifications (low stock / overdue harvests)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AgriTrack <no-reply@example.com>"
NOTIFY_EMAIL_TO=""

# Secret used by the scheduled notifications job (Vercel Cron)
CRON_SECRET="replace-with-a-random-string"
